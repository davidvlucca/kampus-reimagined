# Copia para server/.env se quiseres mudar alguma coisa. Todos os valores são de exemplo.

# Vazio = PGlite (Postgres embutido) em server/.data/pglite. Em produção: o URL do Neon.
DATABASE_URL=
PGLITE_DIR=.data/pglite

API_PORT=3000
# Origens autorizadas a chamar a API com cookies (separadas por vírgulas)
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=7
# Opcional: ativa GET /api/cron/reset-demo (header Authorization: Bearer <valor>)
CRON_SECRET=
NODE_ENV=development
