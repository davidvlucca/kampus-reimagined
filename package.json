{
  "name": "kampus-reimagined",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "npm install && npm run db:reset && npm run dev",
    "dev": "concurrently -k -n api,web -c blue,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w client && npm run build -w server",
    "test": "vitest run",
    "prints": "node scripts/prints.ts",
    "video": "node scripts/video.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "sharp": "^0.35.5"
  }
}
